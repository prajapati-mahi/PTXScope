// ==============================================================================
// PTXScope Sample 03: Redundant Moves & Copy Simplification
//
// Compiler Concepts Demonstrated:
// - Detection of no-op self-moves (mov %r1, %r1) generated by unoptimized code.
// - Copy propagation patterns where redundant registers are copied needlessly.
// - Algebraic identity simplifications (x + 0 -> x, x * 1 -> x).
//
// Expected Parser Behavior:
// - Clean parse with 0 errors.
//
// Expected Diagnostics:
// - Suggestion S001_REDUNDANT_MOV reported on self-move instructions.
//
// Expected Optimization Results:
// - Self-moves removed completely.
// - 'add.u32 %r2, %r1, 0;' simplified to 'mov.u32 %r2, %r1;'.
// - 'mul.lo.u32 %r3, %r2, 1;' simplified to 'mov.u32 %r3, %r2;'.
// ==============================================================================

.version 7.0
.target sm_70
.address_size 64

.entry test_redundant_moves(
    .param .u64 out_ptr
) {
    .reg .u64 %rd1;
    .reg .u32 %r<8>;

    ld.param.u64 %rd1, [out_ptr];
    mov.u32 %r0, 42;

    // Redundant self-moves
    mov.u32 %r0, %r0;

    // Algebraic identity additions and multiplications
    add.u32 %r1, %r0, 0;
    mul.lo.u32 %r2, %r1, 1;

    // Write final result
    st.global.u32 [%rd1], %r2;

    ret;
}

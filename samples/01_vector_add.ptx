// ==============================================================================
// PTXScope Sample 01: Vector Addition
//
// Compiler Concepts Demonstrated:
// - Standard CUDA kernel signature (.entry) with 64-bit memory pointer parameters.
// - Thread indexing via built-in special registers (%ctaid.x, %ntid.x, %tid.x).
// - Multiply-add (mad.lo.s32) for global index calculation.
// - Memory addresses calculation via 64-bit pointer arithmetic (mul.wide, add.u64).
// - Coalesced global memory loads (ld.global) and stores (st.global).
//
// Expected Parser Behavior:
// - Parses cleanly with 0 syntax errors.
// - Identifies 1 entry function, 4 parameters, and 1 primary basic block.
//
// Expected Diagnostics:
// - No errors or warnings.
//
// Expected Optimization Results:
// - All instructions contribute to global memory writes; no dead code.
// ==============================================================================

.version 7.0
.target sm_70
.address_size 64

.entry vector_add(
    .param .u64 ptr_a,
    .param .u64 ptr_b,
    .param .u64 ptr_c,
    .param .u32 num_elements
) {
    .reg .u64 %rd<8>;
    .reg .u32 %r<8>;
    .reg .pred %p0;

    // Load kernel arguments
    ld.param.u64 %rd1, [ptr_a];
    ld.param.u64 %rd2, [ptr_b];
    ld.param.u64 %rd3, [ptr_c];
    ld.param.u32 %r0, [num_elements];

    // Compute global thread ID: idx = ctaid.x * ntid.x + tid.x
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.s32 %r4, %r1, %r2, %r3;

    // Boundary check: if (idx >= num_elements) return;
    setp.ge.s32 %p0, %r4, %r0;
    @p0 bra exit_kernel;

    // Compute memory offsets: offset = idx * 4 bytes
    mul.wide.u32 %rd4, %r4, 4;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd6, %rd2, %rd4;
    add.u64 %rd7, %rd3, %rd4;

    // Load elements from global memory
    ld.global.u32 %r5, [%rd5];
    ld.global.u32 %r6, [%rd6];

    // Perform vector element addition
    add.u32 %r7, %r5, %r6;

    // Store computed sum to output array
    st.global.u32 [%rd7], %r7;

exit_kernel:
    ret;
}
